// Copy to Secrets.xcconfig and fill in values for production backend.
//
// NOTE: .xcconfig files treat "//" as a comment delimiter anywhere on the line, which
// truncates URLs like "https://...". Escape it as "https:/$()/..." — the empty "$()"
// macro reference breaks up the "//" without changing the expanded value.
// SUPABASE_URL = https:/$()/your-project.supabase.co
// SUPABASE_ANON_KEY = your-anon-key
// GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com
